# --- App ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=securevault
DB_LOGGING=false

# --- JWT ---
JWT_ACCESS_SECRET=replace-me-access
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-me-refresh
JWT_REFRESH_EXPIRES=7d

# --- Encryption (32-byte hex / 64 chars) ---
MASTER_ENCRYPTION_KEY=replace-me-with-64-hex-chars

# --- Redis (queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Webhooks ---
WEBHOOK_SIGNING_SECRET=replace-me
WEBHOOK_MAX_RETRIES=5
